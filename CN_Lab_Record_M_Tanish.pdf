%PreformattedPara
0 0 0 rg
BT 1 0 0 1 0 328.6 Tm /F5+0 7.4 Tf 9.6 TL (import socket) Tj T* (import threading) Tj T* (host = '127.0.0.1') Tj T* (port = 9999) Tj T* (def create_server_socket\(\):) Tj T* (    server = socket.socket\(socket.AF_INET, socket.SOCK_STREAM\)) Tj T* (    server.bind\(\(host, port\)\)) Tj T* (    server.listen\(5\)) Tj T* (    print\(f"[+] Listening on {host}:{port}"\)) Tj T* (    return server) Tj T* (def handle_client\(conn, addr\):) Tj T* (    print\(f"[+] Connection established with {addr[0]}:{addr[1]}"\)) Tj T* (    while True:) Tj T* (        try:) Tj T* (            command = input\(f"{addr[0]}@shell> "\)) Tj T* (            if command.lower\(\) == 'quit':) Tj T* (                conn.send\(command.encode\(\)\)) Tj T* (                conn.close\(\)) Tj T* (                break) Tj T* (            if command.strip\(\):) Tj T* (                conn.send\(command.encode\(\)\)) Tj T* (                response = conn.recv\(4096\).decode\(\)) Tj T* (                print\(response\)) Tj T* (        except Exception as e:) Tj T* (            print\(f"[!] Error: {e}"\)) Tj T* (            conn.close\(\)) Tj T* (            break) Tj T* (def start_server\(\):) Tj T* (    server = create_server_socket\(\)) Tj T* (    while True:) Tj T* (        conn, addr = server.accept\(\)) Tj T* (        client_thread = threading.Thread\(target=handle_client, args=\(conn, addr\)\)) Tj T* (        client_thread.start\(\)) Tj T* (if __name__ == "__main__":) Tj T* (    start_server\(\)) Tj T* ET
