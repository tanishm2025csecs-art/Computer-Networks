BT 1 0 0 1 0 175 Tm /F5+0 7.4 Tf 9.6 TL (from xmlrpc.server import SimpleXMLRPCServer) Tj T* (def add\(a,b\):) Tj T* (    return a+b) Tj T* (def sub\(a,b\):) Tj T* (    return a-b) Tj T* (def mul\(a,b\):) Tj T* (    return a*b) Tj T* (def div\(a,b\):) Tj T* (    return a/b) Tj T* (def mod\(a,b\):) Tj T* (    return a%b) Tj T* (server = SimpleXMLRPCServer\(\("localhost", 8000\)\)) Tj T* (print\("Listening on port 8000..."\)) Tj T* (server.register_function\(add, "add"\)) Tj T* (server.register_function\(sub, "sub"\)) Tj T* (server.register_function\(mul, "mul"\)) Tj T* (server.register_function\(div, "div"\)) Tj T* (server.register_function\(mod, "mod"\)) Tj T* (server.serve_forever\(\)) Tj T* ET
