BT 1 0 0 1 0 155.8 Tm /F5+0 7.4 Tf 9.6 TL (import socket) Tj T* (sockfd=socket.socket\(socket.AF_INET, socket.SOCK_STREAM\)) Tj T* (print\('Socket Created'\)) Tj T* (sockfd.bind\(\('localhost',55555\)\)) Tj T* (sockfd.listen\(3\)) Tj T* (print\('Waiting for connections'\)) Tj T* (while True:) Tj T* (    clientfd,addr=sockfd.accept\(\)) Tj T* (    receivedMsg=clientfd.recv\(1024\).decode\(\)) Tj T* (    print\("Connected with ",addr\)) Tj T* (    print\("Message Received from Client: ",receivedMsg\)) Tj T* (    clientfd.send\(bytes\(receivedMsg,'utf-8'\)\)) Tj T* (    print\("Message reply sent to Client!"\)) Tj T* (    print\("Do you want to continue\(type y or n\):"\)) Tj T* (    choice=input\(\)) Tj T* (    if choice=='n':) Tj T* (        break) Tj T* ET
