BT 1 0 0 1 0 280.6 Tm /F5+0 7.4 Tf 9.6 TL (import socket) Tj T* (import struct) Tj T* (import binascii) Tj T* (import textwrap) Tj T* (def main\(\):) Tj T* (    host = socket.gethostbyname\(socket.gethostname\(\)\)) Tj T* (    print\('IP: {}'.format\(host\)\)) Tj T* (    conn = socket.socket\(socket.AF_INET, socket.SOCK_RAW, socket.IPPROTO_IP\)) Tj T* (    conn.bind\(\(host, 0\)\)) Tj T* (    conn.setsockopt\(socket.IPPROTO_IP, socket.IP_HDRINCL, 1\)) Tj T* (    conn.ioctl\(socket.SIO_RCVALL, socket.RCVALL_ON\)) Tj T* (    while True:) Tj T* (        raw_data, addr = conn.recvfrom\(65536\)) Tj T* (        dest_mac, src_mac, eth_proto, data = ethernet_frame\(raw_data\)) Tj T* (        print\('\\nEthernet Frame:'\)) Tj T* (        print\("Destination MAC: {}".format\(dest_mac\)\)) Tj T* (        print\("Source MAC: {}".format\(src_mac\)\)) Tj T* (        print\("Protocol: {}".format\(eth_proto\)\)) Tj T* (def ethernet_frame\(data\):) Tj T* (    dest_mac, src_mac, proto = struct.unpack\('!6s6s2s', data[:14]\)) Tj T* (    return get_mac_addr\(dest_mac\), get_mac_addr\(src_mac\), get_protocol\(proto\), data[14:]) Tj T* (def get_mac_addr\(bytes_addr\):) Tj T* (    bytes_str = map\('{:02x}'.format, bytes_addr\)) Tj T* (    mac_address = ':'.join\(bytes_str\).upper\(\)) Tj T* (    return mac_address) Tj T* (def get_protocol\(bytes_proto\):) Tj T* (    bytes_str = map\('{:02x}'.format, bytes_proto\)) Tj T* (    protocol = ''.join\(bytes_str\).upper\(\)) Tj T* (    return protocol) Tj T* (main\(\)) Tj T* ET
